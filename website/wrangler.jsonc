// The website, served by Cloudflare at https://vercelian.co.
// Deploy from this folder with `npx wrangler@4 deploy`, and preview it
// locally with `npx wrangler@4 dev`. The www address is in redirect/.
{
  "name": "vercelian",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./public",
    // Addresses that don't exist get public/404.html, with a 404 status.
    "not_found_handling": "404-page"
  },
  // A route answers every request to vercelian.co before it reaches the DNS
  // records Namecheap left behind, which Cloudflare won't let a Custom Domain
  // replace. Keep those records, or the domain stops resolving. To use a
  // Custom Domain instead, delete them in Cloudflare's DNS settings and use
  // { "pattern": "vercelian.co", "custom_domain": true }.
  "routes": [{ "pattern": "vercelian.co/*", "zone_name": "vercelian.co" }],
  // Keep the site's first address, vercelian.deebov.workers.dev, working.
  // public/_headers keeps it out of search.
  "workers_dev": true
}
