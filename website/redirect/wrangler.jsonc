// Sends www.vercelian.co to the same address on https://vercelian.co.
// Deploy from this folder with `npx wrangler@4 deploy`.
{
  "name": "vercelian-www",
  "main": "worker.js",
  "compatibility_date": "2026-11-02",
  // A route, like the site's: see ../wrangler.jsonc.
  "routes": [{ "pattern": "www.vercelian.co/*", "zone_name": "vercelian.co" }],
  "workers_dev": false
}
